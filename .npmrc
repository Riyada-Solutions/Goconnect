auto-install-peers=false
strict-peer-dependencies=false
# Flat (hoisted) node_modules instead of pnpm's default .pnpm/<pkg>@<version>_<hash>
# nested layout. Needed on Windows: native modules whose CMakeLists.txt reference
# source files outside their own android/ folder (e.g. expo-modules-core's shared
# common/cpp) make CMake double-encode the full absolute install path into the
# object file name, blowing well past the 250-char CMAKE_OBJECT_PATH_MAX even with
# a short virtual-store-dir. Hoisted mode removes the @<version>_<hash> segment
# entirely, which is the only fix short of moving the project to a much shorter
# root path. (The earlier failure seen under this setting was actually an
# unrelated broken orval@8.5.3 lockfile entry in lib/api-spec, since fixed by
# regenerating pnpm-lock.yaml - not a real hoisted-mode incompatibility.)
node-linker=hoisted
virtual-store-dir=D:/.pnpm-vs/goconnect
